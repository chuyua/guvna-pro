# BruvRoute env — copy to .env and fill in. .env* is gitignored.
# ADMIN_KEY: admin token for CLI/UI. Required.
ADMIN_KEY=
# API_KEYS: comma-separated client keys for /v1 clients (app gets one). Required.
API_KEYS=

# Provider keys (referenced by key_env in config.yaml):
BAZAARLINK_1_KEY=
GROQ_1_KEY=
MISTRAL_1_KEY=
GEMINI_1_KEY=
ORCA_1_KEY=