# Guvna env — copy to .env and fill in. .env* is gitignored.
# ADMIN_KEY: admin token for CLI/UI. Required.
ADMIN_KEY=
# API_KEYS: comma-separated client keys for /v1 clients. Required.
API_KEYS=

# Provider keys (referenced by key_envs in config.yaml). Multiple keys per
# provider form a rotation pool: round-robin selection, quarantine on failure
# (401/403 = 24h, 429 = 60s, 5xx/network = 60s), failover within the step.
BAZAARLINK_1_KEY=
BAZAARLINK_2_KEY=
GROQ_1_KEY=
GROQ_2_KEY=
GROQ_3_KEY=
MISTRAL_1_KEY=
GEMINI_1_KEY=
GEMINI_2_KEY=
GEMINI_3_KEY=
ORCA_1_KEY=
ORCA_2_KEY=
ORCA_3_KEY=
# Optional upstream reliability limits; see docs/RELIABILITY.md.
# Go duration syntax. 0 disables ordinary budgets and stream limits below.
# GUVNA_STEP_BUDGET=180s
# GUVNA_REQUEST_BUDGET=300s
# GUVNA_STREAM_IDLE_TIMEOUT=120s
# Hard active-stream deadline, even while upstream data keeps arriving.
# GUVNA_STREAM_MAX_DURATION=10m
# Auto total includes the decider and setup; non-positive disables it.
# Active streams use the separate stream limits after successful headers.
# GUVNA_AUTO_TOTAL_BUDGET=45s
# Auto step applies to non-streaming candidates; requires a positive duration.
# GUVNA_AUTO_STEP_BUDGET=20s
# Maximum buffered upstream response bytes; must be a positive integer.
# GUVNA_MAX_BODY_BYTES=33554432
# Single-choice Chat compatibility opt-out; incomplete endings may be accepted.
# Multiple-choice completeness checks remain required.
# GUVNA_REQUIRE_STREAM_TERMINATOR=true